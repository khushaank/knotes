/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*.supabase.co; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://cloudflareinsights.com; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com; form-action 'self'; upgrade-insecure-requests;

/*.map
  X-Robots-Tag: noindex
  Cache-Control: no-store

/profile
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/invitations
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/dashboard/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/service-worker.js
  Cache-Control: no-cache
